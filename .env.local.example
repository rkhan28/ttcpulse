# Copy to .env.local. Keep secret values out of Git.
# Public TTC surface feeds; no API keys required.
TTC_GTFS_RT_VEHICLES=https://bustime.ttc.ca/gtfsrt/vehicles
TTC_GTFS_RT_TRIPS=https://bustime.ttc.ca/gtfsrt/trips
TTC_GTFS_RT_ALERTS=https://bustime.ttc.ca/gtfsrt/alerts

# Ask Pulse: all three values are required to enable paid model requests.
# Leave blank to run the rest of the app without an assistant.
OPENAI_API_KEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Optional; changing the model requires checking streaming and tool-call support.
# OPENAI_MODEL=gpt-4o

# Optional static-data importer override. Use the SurfaceGTFS companion dataset
# to keep route and stop identifiers consistent with the realtime feeds.
# TTC_GTFS_STATIC_URL=https://ckan0.cf.opendata.inter.prod-toronto.ca/dataset/bd4809dd-e289-4de8-bbde-c5c00dafbf4f/resource/28514055-d011-4ed7-8bb0-97961dfe2b66/download/SurfaceGTFS.zip
